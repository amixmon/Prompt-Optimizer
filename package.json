{
  "name": "prompt-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @prompt-studio/web",
    "dev:api": "npm run dev --workspace @prompt-studio/api",
    "build": "npm run typecheck && npm run build --workspace @prompt-studio/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "test": "node --import tsx --test apps/api/src/**/*.test.ts apps/web/src/lib/__tests__/*.test.ts",
    "format": "vp fmt apps packages scripts README.md package.json tsconfig.base.json",
    "start": "npm run start --workspace @prompt-studio/api"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0"
}
